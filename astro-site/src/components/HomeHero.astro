---
import { readFileSync } from 'node:fs';
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
const { data } = Astro.locals.starlightRoute.entry;
const source = readFileSync('../pyproject.toml', 'utf8');
const version = source.match(/^version\s*=\s*"([^"]+)"/m)?.[1];
if (!version) throw new Error('Missing heartKIT version in pyproject.toml');
const base = import.meta.env.BASE_URL;
const tasks = [['Denoising', 'denoise'], ['Segmentation', 'segmentation'], ['Rhythm', 'rhythm'], ['Beat classification', 'beat']];
const capabilities = [
  ['01', 'Prepare signals', 'ECG and PPG dataset integrations'],
  ['02', 'Build models', 'Configurable architectures and training'],
  ['03', 'Evaluate results', 'Task metrics and saved experiments'],
  ['04', 'Prepare for the edge', 'Model export and task-level demos'],
];
---
{data.hero?.tagline ? <>
  <section class="heartkit-hero" aria-labelledby="_top">
    <div class="hero-meta"><span class="product">heartKIT</span><span class="version">v{version}</span></div>
    <div class="hero-layout">
      <div class="hero-copy">
        <h1 id="_top">Turn heart signals<br /><span>into on-device intelligence.</span></h1>
        <p>{data.hero.tagline}</p>
        <nav class="hero-actions" aria-label="Get started with heartKIT">
          <a class="primary" href={`${base}/quickstart/`}>Get started</a>
          <a href={`${base}/guides/#notebook-training-examples`}>Explore examples</a>
        </nav>
      </div>
      <div class="capabilities" aria-label="heartKIT capabilities">
        <p class="capabilities-label">One configurable workflow</p>
        <ol>{capabilities.map(([number, title, description]) => <li><span class="step">{number}</span><div><strong>{title}</strong><span>{description}</span></div></li>)}</ol>
      </div>
    </div>
  </section>
  <nav class="task-links" aria-label="Explore heart tasks">
    {tasks.map(([label, slug]) => <a href={`${base}/tasks/${slug}/`}>{label}<span aria-hidden="true">↗</span></a>)}
  </nav>
</> : <DefaultHero />}
<style>
  .heartkit-hero { background: #101318; color: #d6d9e0; border: 1px solid #292f38; border-radius: 1.5rem; padding: clamp(1.5rem, 4vw, 3.5rem); }
  .hero-meta { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 2.25rem; }
  .product { color: #f1f3f7; font-size: clamp(1.75rem, 3vw, 2.4rem); font-weight: 750; letter-spacing: -.04em; }
  .product::before { content: ''; display: inline-block; width: .5rem; height: .5rem; background: #f05252; border-radius: 50%; margin: 0 .65rem .35rem 0; }
  .version { border: 1px solid #525966; border-radius: 999px; padding: .35rem .8rem; color: #c1c7d1; white-space: nowrap; font-size: .9rem; font-variant-numeric: tabular-nums; }
  .hero-layout { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  h1 { color: #fff; font-size: clamp(2.25rem, 3.5vw, 3.5rem); line-height: 1.1; letter-spacing: -.04em; margin: 0 0 1.5rem; }
  h1 span { color: #f05252; }
  .hero-copy p { max-width: 57ch; font-size: 1.08rem; line-height: 1.75; }
  nav { display: flex; flex-wrap: wrap; gap: .75rem; }
  .hero-actions { margin-top: 2rem; }
  nav a { display: inline-flex; align-items: center; gap: .75rem; padding: .7rem 1.15rem; border: 1px solid #505761; border-radius: 999px; color: #f3f4f7; text-decoration: none; font-weight: 600; }
  .hero-actions .primary { color: #151219; background: #f05252; border-color: #f05252; }
  .hero-actions a:hover { border-color: #ff7373; background: #28212b; }
  .hero-actions .primary:hover { color: #151219; background: #ff7373; }
  a:focus-visible { outline: 2px solid #f05252; outline-offset: 4px; }
  .capabilities { background: #191e25; border: 1px solid #343d49; border-radius: 1.15rem; padding: 1.35rem; }
  .capabilities-label { color: #c1c7d1; text-transform: uppercase; letter-spacing: .1em; font-size: .72rem; font-weight: 600; margin: 0 0 1.15rem; }
  ol { display: grid; gap: .65rem; list-style: none; margin: 0; padding: 0; }
  li { display: flex; align-items: center; gap: .85rem; border: 1px solid #363f4b; background: #202731; border-radius: .6rem; padding: .85rem; }
  .step { color: #f05252; font-size: .78rem; font-variant-numeric: tabular-nums; }
  li strong { display: block; color: #f0f2f6; font-size: .95rem; }
  li div > span { display: block; color: #bbc3d0; font-size: .8rem; margin-top: .2rem; line-height: 1.45; }
  .task-links { justify-content: center; margin: 1.75rem 0 .25rem; }
  .task-links a { color: var(--heartkit-button-text); border-color: var(--heartkit-button-border); font-weight: 500; }
  .task-links a:hover { background: color-mix(in srgb, var(--heartkit-button-border) 10%, transparent); }
  @media (max-width: 60rem) { .hero-layout { grid-template-columns: 1fr; } .hero-copy p { max-width: 65ch; } ol { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 34rem) { ol { grid-template-columns: 1fr; } .hero-meta { margin-bottom: 1.75rem; } .task-links { gap: .5rem; } .task-links a { font-size: .85rem; padding: .6rem .9rem; } }
</style>
